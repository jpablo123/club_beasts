{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "delivery-orchestrator",
  "instructions": ["AGENTS.md"],
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "allow" },
    { "action": "read", "resource": "*.env.*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "deny" }
  ],
  "agents": {
    "build": { "disabled": true },
    "plan": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "explore": {
      "mode": "subagent",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },
    "delivery-orchestrator": {
      "mode": "primary",
      "description": "Entrada unica de construccion: delega implementacion, mantiene documentos y verifica evidencia.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "docs/**", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "backend-developer", "effect": "allow" },
        { "action": "subagent", "resource": "frontend-developer", "effect": "allow" },
        { "action": "subagent", "resource": "database-admin", "effect": "allow" },
        { "action": "subagent", "resource": "test-engineer", "effect": "allow" },
        { "action": "subagent", "resource": "devops-engineer", "effect": "allow" },
        { "action": "subagent", "resource": "code-reviewer", "effect": "allow" },
        { "action": "subagent", "resource": "acceptance-criteria-analyst", "effect": "allow" },
        { "action": "subagent", "resource": "ui-navigation-auditor", "effect": "allow" },
        { "action": "subagent", "resource": "explore", "effect": "allow" }
      ]
    },
    "ui-navigation-auditor": {
      "mode": "subagent",
      "description": "Audita recorridos y salidas por rol con evidencia ejecutada; reporta bloqueos sin editar producto ni pruebas."
    },
    "backend-developer": {
      "mode": "subagent",
      "description": "Backend API development with Fastify, Prisma, TypeScript. Routes, services, plugins, business logic."
    },
    "frontend-developer": {
      "mode": "subagent",
      "description": "Frontend development with Next.js, React, Tailwind CSS. Pages, components, UI/UX."
    },
    "database-admin": {
      "mode": "subagent",
      "description": "Database management with Prisma. Schema design, migrations, seed data, data modeling."
    },
    "test-engineer": {
      "mode": "subagent",
      "description": "Testing with Vitest, Playwright. Unit tests, integration tests, e2e tests, TDD/ATDD."
    },
    "devops-engineer": {
      "mode": "subagent",
      "description": "DevOps, deployment, CI/CD. Vercel, Railway, Neon, infrastructure."
    },
    "code-reviewer": {
      "mode": "subagent",
      "description": "Code review, quality assurance, security review, best practices."
    },
    "acceptance-criteria-analyst": {
      "mode": "subagent",
      "description": "Análisis de historias de usuario con técnicas ISTQB. Genera criterios de aceptación, Gherkin scenarios y schemas zod de validación. Modos: CREAR (nuevos criterios), REFACTORIZAR (auditar código vs criterios), AVANZAR (verificar avance)."
    }
  }
}
